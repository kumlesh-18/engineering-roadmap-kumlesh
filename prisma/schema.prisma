generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  emailVerified         DateTime?
  name                  String?
  image                 String?
  passwordHash          String?   @map("password_hash")
  role                  Role      @default(USER)
  subscriptionTier      SubscriptionTier @default(FREE) @map("subscription_tier")
  subscriptionStatus    SubscriptionStatus @default(INACTIVE) @map("subscription_status")
  stripeCustomerId      String?   @unique @map("stripe_customer_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  accounts              Account[]
  sessions              Session[]
  apiKeys               UserApiKey[] @relation("UserApiKeys")
  progress              UserProgress[]
  quizAttempts          QuizAttempt[]
  chatSessions          ChatSession[]
  createdRoadmaps       Roadmap[] @relation("RoadmapAuthor")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  provider     String
  encryptedKey String   @map("encrypted_key")
  keyName      String?  @map("key_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation("UserApiKeys", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("user_api_keys")
}

model Roadmap {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  version     Int      @default(1)
  isPublished Boolean  @default(false) @map("is_published")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy   User?    @relation("RoadmapAuthor", fields: [createdById], references: [id])
  nodes       Node[]
  edges       Edge[]
  documents   Document[]

  @@map("roadmaps")
}

model Node {
  id              String   @id @default(cuid())
  roadmapId       String   @map("roadmap_id")
  parentId        String?  @map("parent_id")
  type            NodeType
  title           String
  description     String?
  contentMdx      String?  @map("content_mdx")
  positionX       Float    @default(0) @map("position_x")
  positionY       Float    @default(0) @map("position_y")
  orderIndex      Int      @default(0) @map("order_index")
  estimatedHours  Float?   @map("estimated_hours")
  difficulty      Difficulty?
  prerequisites   String[] @map("prerequisites")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  roadmap         Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  parent          Node?    @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Node[]   @relation("NodeHierarchy")
  sourceEdges     Edge[]   @relation("SourceEdges")
  targetEdges     Edge[]   @relation("TargetEdges")
  progress        UserProgress[]
  quizAttempts    QuizAttempt[]
  chatSessions    ChatSession[]
  documents       Document[]

  @@index([roadmapId])
  @@index([parentId])
  @@map("nodes")
}

model Edge {
  id         String   @id @default(cuid())
  roadmapId  String   @map("roadmap_id")
  sourceId   String   @map("source_id")
  targetId   String   @map("target_id")
  type       EdgeType @default(PREREQUISITE)
  label      String?

  roadmap    Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  source     Node     @relation("SourceEdges", fields: [sourceId], references: [id], onDelete: Cascade)
  target     Node     @relation("TargetEdges", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
  @@index([sourceId])
  @@index([targetId])
  @@map("edges")
}

model UserProgress {
  id               String        @id @default(cuid())
  userId           String        @map("user_id")
  nodeId           String        @map("node_id")
  status           ProgressStatus @default(LOCKED)
  score            Int?
  attempts         Int           @default(0)
  startedAt        DateTime?     @map("started_at")
  completedAt      DateTime?     @map("completed_at")
  timeSpentSeconds Int           @default(0) @map("time_spent_seconds")

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  node             Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([userId])
  @@index([nodeId])
  @@map("user_progress")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  nodeId    String   @map("node_id")
  answers   Json
  score     Int
  passed    Boolean
  timeSeconds Int?  @map("time_seconds")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nodeId])
  @@map("quiz_attempts")
}

model ChatSession {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  nodeId         String?  @map("node_id")
  title          String?
  modelProvider  String?  @map("model_provider")
  modelName      String?  @map("model_name")
  systemPrompt   String?  @map("system_prompt")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  node           Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@index([userId])
  @@index([nodeId])
  @@map("chat_sessions")
}

model Message {
  id            String   @id @default(cuid())
  sessionId     String   @map("session_id")
  role          MessageRole
  content       String?
  toolCalls     Json?    @map("tool_calls")
  toolCallId    String?  @map("tool_call_id")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("messages")
}

model Document {
  id          String   @id @default(cuid())
  roadmapId   String   @map("roadmap_id")
  nodeId      String?  @map("node_id")
  title       String?
  content     String
  contentHash String   @map("content_hash")
  embedding   Unsupported("vector(1536)") // pgvector
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  node        Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([roadmapId])
  @@index([nodeId])
  @@map("documents")
}

enum Role {
  ADMIN
  AUTHOR
  PREMIUM
  USER
  GUEST
}

enum SubscriptionTier {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum NodeType {
  TOPIC
  CONCEPT
  PROJECT
  QUIZ
  RESOURCE
  MILESTONE
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EdgeType {
  PREREQUISITE
  RELATED
  SEQUENCE
  ALTERNATIVE
}

enum ProgressStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  MASTERED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}