# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ai_roadmap?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-generate-with-openssl-rand-base64-32"

# OAuth Providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (optional)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=""
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""

# Stripe (optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# AI Providers (Managed - optional)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# Encryption (for BYOK API keys)
ENCRYPTION_KEY="32-character-base64-encoded-key"

# Feature Flags
ENABLE_RAG=true
ENABLE_QUIZ_GENERATION=true
ENABLE_KNOWLEDGE_GRAPH=true